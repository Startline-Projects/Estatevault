NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
ANTHROPIC_API_KEY=

# Which document pipeline generates PDFs.
#   (unset)          Legacy path: Claude drafts the text, pdf-lib renders it.
#   react-pdf        Deterministic v1.1.0 templates via React-PDF. Falls back to
#                    the legacy path when a document cannot be rendered. Staged rollout.
#   react-pdf-strict Deterministic templates only. A document that cannot be
#                    rendered correctly is marked 'blocked', the order is held back
#                    from delivery, and SALES_NOTIFICATION_EMAIL is alerted.
#
# NOTE: a Trust Package cannot be fulfilled with this unset. Four of its documents
# (Certification of Trust, both Assignments of Personal Property, Funding
# Instructions) exist only as templates; with no renderer they are marked
# 'blocked', the order is held and SALES_NOTIFICATION_EMAIL is alerted once.
PDF_RENDERER=
# Set to true in local/dev to generate placeholder documents without calling
# the Anthropic API (no credits spent). Never set in production.
MOCK_DOC_GENERATION=
RESEND_API_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLIENT_HOST=app.localhost:3000
NEXT_PUBLIC_PARTNER_HOST=pro.localhost:3000
NEXT_PUBLIC_ADMIN_HOST=admin.localhost:3000
NEXT_PUBLIC_SALES_HOST=sales.localhost:3000
NEXT_PUBLIC_ATTORNEY_HOST=attorney.localhost:3000
HANDOFF_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SALES_NOTIFICATION_EMAIL=

# DOCX -> PDF conversion for attorney-edited documents.
# Prod (Vercel): set CLOUDCONVERT_API_KEY. Local dev: install LibreOffice instead
# (brew install --cask libreoffice) or set SOFFICE_PATH.
DOC_CONVERT_PROVIDER=
CLOUDCONVERT_API_KEY=
SOFFICE_PATH=

# Option A KEK (32 raw bytes, base64). Local dev only; prod uses Vault secret ev_kek_v1.
EV_KEK_BASE64=

# ── Promo codes ──────────────────────────────────────────────────────────────
# Comma-separated CODE:kind pairs. EMPTY BY DEFAULT — leave unset and no promo
# code works, which is the safe state. Codes used to be hardcoded in the source
# and permanently active; they are configuration now so a code can be turned off
# without a deploy.
#
#   kind "free" — order total becomes 0, documents generate, no Stripe session
#   kind "test" — the order runs against Stripe test mode
#
# A malformed entry is ignored, so a typo cannot become a working free-order
# code. Codes are matched case-insensitively.
#
# PROMO_CODES="LAUNCH24:free,SMOKE:test"
PROMO_CODES=
